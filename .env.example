# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=kalasathi
POSTGRES_USER=kalasathi
POSTGRES_PASSWORD=kalasathi_secret
DATABASE_URL=postgresql+asyncpg://kalasathi:kalasathi_secret@localhost:5432/kalasathi

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 days

# ─── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=kalasathi-media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# ─── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_MOCK_MODE=true          # no image processing; results are marked mock and cannot be published

# ─── CrewAI AMP (backend only — never expose the token to Flutter/web) ────────
CREWAI_API_BASE_URL=https://karigarai-product-image-processing-agent-v1-4812b293.crewai.com
CREWAI_BEARER_TOKEN=your_crewai_bearer_token_here

# MongoDB stores queryable image-job output JSON; PostgreSQL remains authoritative for commerce.
# Cloudinary is optional and takes precedence when all three credentials are configured.
MONGODB_URI=mongodb://localhost:27017/kalasathi
MONGODB_DB_NAME=kalasathi
MONGODB_REQUIRED=true
# Docker Compose API containers use this service hostname (or set your external URI here).
MONGODB_URI_DOCKER=mongodb://mongo:27017/kalasathi
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Public address the deployed CrewAI service can use to retrieve originals.
# For production, set this to an internet-reachable HTTPS API or object-storage URL.
PUBLIC_API_URL=https://api.example.com

# ─── Gemini (Catalog generation + translation) ────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Bhashini / ULCA (Primary STT + TTS for Indian languages) ─────────────────
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here

# ─── Google Cloud (Fallback STT + TTS) ───────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Firebase (FCM Push Notifications) ────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={}   # paste JSON inline or set path below
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# ─── Razorpay (Payment — test mode) ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# ─── OTP (SMS provider) ───────────────────────────────────────────────────────
OTP_PROVIDER=mock           # mock | twilio | msg91
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# ─── Web (Next.js) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_your_key_here
